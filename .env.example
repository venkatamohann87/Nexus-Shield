# PostgreSQL is used by the production Prisma adapter. The local runtime below persists
# its security events and local accounts to data/runtime-store.json.
DATABASE_URL=postgresql://humanshield:change-me@localhost:5432/humanshield
AUTH_SECRET=replace-with-a-long-random-secret
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local Phi-4 through Ollama. These values stay server-side; never expose them in browser code.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=phi4-mini:latest
# Optional local image-to-text reader used before HumanShield evaluates an image attachment.
LOCAL_VISION_MODEL=moondream:latest
# A constrained context keeps the local Phi model within typical 8 GB machines.
LOCAL_LLM_NUM_CTX=2048
# Set only when deliberately using a trusted non-local Ollama endpoint.
LOCAL_LLM_ALLOW_REMOTE=false
# Only this exact local Phi chat is permitted to call the browser gateway API.
PHI_CLIENT_ORIGIN=http://localhost:3001
